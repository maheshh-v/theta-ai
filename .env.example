# ---------------------------------------------------------------------------
# Personal AI Assistant — environment configuration
# Copy this file to ".env" and fill in what you need. Everything is optional:
# with no keys set, the app runs on a built-in mock LLM (clearly labelled).
# ---------------------------------------------------------------------------

# Which LLM to use: gemini | ollama | mock
# Leave blank to auto-detect: Gemini if GEMINI_API_KEY is set, else mock.
LLM_PROVIDER=

# --- Google Gemini (free tier) ---------------------------------------------
# Get a free API key at: https://aistudio.google.com/app/apikey
# (Google AI Studio → "Create API key". No billing required for the free tier.)
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash; the app also falls back across
# gemini-2.0-flash / gemini-1.5-flash automatically if a model name is retired.
GEMINI_MODEL=gemini-2.5-flash

# --- Local Ollama (free, offline) ------------------------------------------
# Install from https://ollama.com, then: `ollama pull llama3.2`
# Set LLM_PROVIDER=ollama to use it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Agent behaviour --------------------------------------------------------
# Max reasoning/tool-call steps per command.
MAX_AGENT_STEPS=5
