# ---------------------------------------------------------------------------
# Theta — environment configuration
# Copy to ".env" and fill in what you need.
#
# Only ONE thing is required: a language model. No accounts, no OAuth, no
# sign-up. Everything else has a working default.
# ---------------------------------------------------------------------------

# === REQUIRED: a language model ============================================
# The model works out HOW to do a task. Saved Playbooks replay without it.
# Which provider: gemini | ollama | openai  (blank = auto-detect from the keys)
LLM_PROVIDER=

# --- Option A: Google Gemini (free tier, easiest) --------------------------
# Free key at https://aistudio.google.com/app/apikey — no billing required.
GEMINI_API_KEY=
# "gemini-flash-latest" tracks the current flash model. Avoid pinning a version:
# Google retires them, and a retired name returns 404.
GEMINI_MODEL=gemini-flash-latest

# --- Option B: Ollama (local, offline, free) -------------------------------
# Install from https://ollama.com then: ollama pull llama3.1
# Operating a browser asks a lot of a model; 8B+ is the realistic floor.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Option C: any OpenAI-compatible endpoint ------------------------------
# Works with OpenAI, Groq, OpenRouter, Together, vLLM, LM Studio.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === Browser ================================================================
# Headless (default) means you watch through the live view in the UI.
# Set to 0 to show the real Chromium window — then you can take the keyboard
# yourself, which is how you handle logins (Theta never types a password).
THETA_BROWSER_HEADLESS=1
THETA_BROWSER_WIDTH=1280
THETA_BROWSER_HEIGHT=900
THETA_BROWSER_TIMEOUT=30

# Actions per task. A navigate-search-filter-extract journey is easily fifteen.
MAX_AGENT_STEPS=28

# === OPTIONAL: web search ===================================================
# Used to find a URL when you don't give one, and by the deep-research tool.
# duckduckgo (default, no key) | tavily | brave
#
# DuckDuckGo needs no key, so Theta works out of the box — but it rate-limits
# automated use. For anything beyond casual use add a free Tavily key.
SEARCH_PROVIDER=
TAVILY_API_KEY=          # https://tavily.com
BRAVE_API_KEY=           # https://brave.com/search/api/

# === OPTIONAL: the research tool ============================================
RESEARCH_BREADTH=4         # sub-questions per brief (1-8)
SOURCES_PER_QUESTION=4     # search results per sub-question (1-10)
MAX_SOURCES=14             # total pages read per brief (1-40)

# === OPTIONAL: server =======================================================
THETA_HOST=127.0.0.1
THETA_PORT=7860            # PORT is also honoured, for hosts that inject it
PUBLIC_BASE_URL=

# Stable key encrypting stored API keys at rest. Any string works (it is hashed
# into a Fernet key). If unset, a local key file is generated for development.
# Generate a strong one:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
THETA_SECRET_KEY=
THETA_COOKIE_SECURE=       # set to 1 when serving over HTTPS

# Let the agent browse private/loopback addresses. Off by default: the agent
# chooses which URLs to open, and this guard stops a crafted page from steering
# it into your internal network. Only enable for an intranet automation setup.
THETA_ALLOW_PRIVATE_URLS=
