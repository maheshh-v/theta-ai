# ---------------------------------------------------------------------------
# Personal AI Assistant — environment configuration
# Copy this file to ".env" and fill in what you need. Everything is optional:
# with no keys set, the app runs on a built-in mock LLM (clearly labelled).
# ---------------------------------------------------------------------------

# Which LLM to use: gemini | ollama | mock
# Leave blank to auto-detect: Gemini if GEMINI_API_KEY is set, else mock.
LLM_PROVIDER=

# --- Google Gemini (free tier) ---------------------------------------------
# Get a free API key at: https://aistudio.google.com/app/apikey
# (Google AI Studio → "Create API key". No billing required for the free tier.)
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash; the app also falls back across
# gemini-2.0-flash / gemini-1.5-flash automatically if a model name is retired.
GEMINI_MODEL=gemini-2.5-flash

# --- Local Ollama (free, offline) ------------------------------------------
# Install from https://ollama.com, then: `ollama pull llama3.2`
# Set LLM_PROVIDER=ollama to use it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Agent behaviour --------------------------------------------------------
# Max reasoning/tool-call steps per command.
MAX_AGENT_STEPS=5

# --- Google OAuth (real Gmail + Calendar) ----------------------------------
# Create a Google Cloud project, enable the Gmail API + Google Calendar API,
# configure the OAuth consent screen (add yourself as a Test user), then create
# an OAuth client ID of type "Web application". See the README for the full
# checklist. Add this redirect URI to the client:
#   http://localhost:7860/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the redirect URI (must match one registered on the client).
# Leave blank to derive it from PUBLIC_BASE_URL or host:port automatically.
GOOGLE_REDIRECT_URI=
# When deploying, set this to the app's public URL so redirects are correct,
# e.g. https://your-space.hf.space
PUBLIC_BASE_URL=

# --- Server / security ------------------------------------------------------
# Host/port the app binds to.
THETA_HOST=127.0.0.1
THETA_PORT=7860
# Stable key that encrypts stored tokens/keys at rest. Any string works (it is
# hashed to a Fernet key). If unset, a local key file is generated for dev.
# Generate a strong one:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
THETA_SECRET_KEY=
# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
THETA_COOKIE_SECURE=
