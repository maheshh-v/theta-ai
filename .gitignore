# Secrets
.env
data/.secret_key
data/sessions.enc
data/sessions.enc.tmp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# The user's own data, not source: run traces and screenshots, saved
# automations, files the agent produced, and research briefs.
data/runs/
data/playbooks/
data/workspace/
data/briefs/
# Schedules additionally carry `owner_sid` — the session id whose connected
# accounts an unattended run uses. That is a credential-adjacent value and must
# never reach the repository.
data/schedules/

# Local scratch / OS
*.tmp
data/*.json.tmp
.DS_Store
Thumbs.db

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
